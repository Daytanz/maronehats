# Marone 1881 — generato da build.py
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

<IfModule mod_rewrite.c>
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
</IfModule>

Redirect 301 /estate/ /campagna-ss26/
Redirect 301 /inverno/ /modelli-icona/
Redirect 301 /en/summer/ /en/ss26-campaign/
Redirect 301 /en/winter/ /en/icon-models/
Redirect 301 /fr/ete/ /fr/campagne-ss26/
Redirect 301 /fr/hiver/ /fr/modeles-icones/
Redirect 301 /de/summer/ /de/kampagne-ss26/
Redirect 301 /de/winter/ /de/ikonen/
Redirect 301 /es/verano/ /es/campana-ss26/
Redirect 301 /es/invierno/ /es/modelos-icono/
Redirect 301 /ja/summer/ /ja/ss26-campaign/
Redirect 301 /ja/winter/ /ja/icon-models/
Redirect 301 /thank-you.html /grazie/
Redirect 301 /es/thank-you.html /es/gracias/

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(woff2|webp|avif|jpg|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
